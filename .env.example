# ISL Sign-to-Speech — Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Provider ────────────────────────────────────────────
# Options: "google", "openai", "groq", "fallback"
# If not set, auto-detects from available API keys.
# "fallback" requires no API — uses local grammar rules.
# LLM_PROVIDER=google

# ── Google Gemini ───────────────────────────────────────────
# Required when LLM_PROVIDER=google (or auto-detected).
# Get a key at: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# ── OpenAI ──────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai.
# OPENAI_API_KEY=your-openai-api-key-here

# ── Groq ─────────────────────────────────────────────────────
# Required when LLM_PROVIDER=groq. Uses Groq's OpenAI-compatible API.
# GROQ_API_KEY=your-groq-api-key-here
